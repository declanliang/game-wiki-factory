# Required. Mixed-case toapis_API_KEY is also accepted for compatibility.
TOAPIS_API_KEY=

# Optional fallback when ToAPIs web research fails
PERPLEXITY_API_KEY=

# Optional overrides
TOAPIS_MODEL=gpt-5.3-codex-official
TOAPIS_WEB_MODEL=gpt-5.3-codex-official
TOAPIS_REASONING_EFFORT=low
PERPLEXITY_MODEL=sonar-pro
GAMEWIKI_OUTPUT_DIR=output
GAMEWIKI_CACHE_DIR=.cache
GAMEWIKI_REQUEST_TIMEOUT=300
