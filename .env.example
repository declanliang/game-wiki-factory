# Private configuration for gamewiki.py. Copy this file to `.env` at the
# factory root. The orchestrator also reads pipeline/*/.env during migration.

TOAPIS_API_KEY=
PERPLEXITY_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPER_API_KEY=
JINA_API_KEY=
LLM_API_KEY_1=
LLM_API_KEY_2=
LLM_API_KEY_3=

# Optional publish credentials for unattended/CI publishing. Local runs may reuse authenticated gh/vercel CLI sessions.
FACTORY_GITHUB_TOKEN=
FACTORY_GITHUB_OWNER=declanliang
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Optional model/runtime overrides used by the child tools.
TOAPIS_MODEL=gpt-5.3-codex-official
TOAPIS_WEB_MODEL=gpt-5.3-codex-official
TOAPIS_REASONING_EFFORT=low
PERPLEXITY_MODEL=sonar-pro
GAMEWIKI_REQUEST_TIMEOUT=300
