# Private configuration for gamewiki.py. Copy this file to `.env` at the
# factory root. This is the only maintained .env for all pipeline modules.

TOAPIS_API_KEY=
PERPLEXITY_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPER_API_KEY_1=
SERPER_API_KEY_2=
JINA_API_KEY_1=
JINA_API_KEY_2=
LLM_API_KEY_1=
LLM_API_KEY_2=
LLM_API_KEY_3=

# Optional publish credentials for unattended/CI publishing. Local runs may reuse authenticated gh/vercel CLI sessions.
FACTORY_GITHUB_TOKEN=
FACTORY_GITHUB_OWNER=declanliang
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Optional model/runtime overrides used by the child tools.
TOAPIS_MODEL=gpt-5.3-codex-official
TOAPIS_WEB_MODEL=gpt-5.3-codex-official
TOAPIS_REASONING_EFFORT=low
PERPLEXITY_MODEL=sonar-pro
GAMEWIKI_REQUEST_TIMEOUT=300

# Persistent background worker and loopback OpenClaw control plane.
GAMEWIKI_DATA_DIR=
GAMEWIKI_PROJECTS_ROOT=
GAMEWIKI_JOB_CONCURRENCY=2
GAMEWIKI_SUCCESS_RETENTION_HOURS=72
GAMEWIKI_FAILED_RETENTION_DAYS=14
GAMEWIKI_DISK_PAUSE_PERCENT=80
GAMEWIKI_PRUNE_SUCCESS_BUILD_ARTIFACTS=1
GAMEWIKI_CONTROL_HOST=127.0.0.1
GAMEWIKI_CONTROL_PORT=8787
GAMEWIKI_CONTROL_TOKEN=
# JSON argv for a delivery command. Exactly one item must contain {message}.
# Example server value uses `openclaw message send`; keep account/target private.
GAMEWIKI_NOTIFICATION_COMMAND_JSON=
