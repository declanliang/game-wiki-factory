# Static export branch: localePrefix is "always" (see src/i18n/routing.ts) —
# static export has no middleware to rewrite bare "/" to "/en" at request
# time, so every locale including English is prefixed. These 301s exist so
# that accidental unprefixed links still resolve instead of 404ing.
#
# _redirects is evaluated top-to-bottom, first match wins, BEFORE static
# asset serving. Do NOT add a generic `/:type -> /en/:type` catch-all rule —
# it will also match `/_next/*`, `/api/*`, `/images/*`, etc. and break asset
# loading. List only the actual top-level content-type slugs for this game
# (matches CONTENT_TYPES / the published categories in src/config/site-plan.json).
#
# TODO (per-site setup step): fill in one pair of rules per published content
# type below, following this pattern:
#   /<type>         /en/<type>         301
#   /<type>/*       /en/<type>/:splat  301
# Brand-new sites keep only the fixed legal redirects below; generated
# category rules are added by sync-categories.mjs.

/                    /en                    301
/about               /en/about              301
/copyright           /en/copyright          301
/privacy-policy      /en/privacy-policy     301
/terms-of-service    /en/terms-of-service   301
