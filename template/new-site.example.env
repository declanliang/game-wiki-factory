# 这个文件现在完全可选——标准流程不需要创建它，也不需要填任何一行。
#
# 只要素材按下面的约定放进 intake/ 就够了，npm run check:intake / launch:site 会自动识别：
#   intake/site-identity.json            — GAME_NAME/OFFICIAL_GAME_URL 等身份字段（格式见 doc/homepage-info-schema.md）
#   intake/articles/<locale>/<category>/*.mdx
#   intake/site-content.json
#   intake/hero/（放一张或多张候选图，自动选第一个）或 intake/hero.<任意后缀>
#   intake/favicon/（已生成好的整套）或 intake/logo.<任意后缀>（单张源图，脚本生成整套）
#
# 只有想覆盖上面某一条约定路径时（比如素材放在别的地方、想手动指定用哪张 hero 图），
# 才需要复制这个文件成 new-site.env，只填你要覆盖的那一行，其余留空——留空的字段会
# 按上面的约定路径自动解析，不会因为这个文件存在就要求你填满每一行。
# new-site.env 不会被提交进 git（见 .gitignore）。

# --- 覆盖身份字段（通常用 intake/site-identity.json 就够，这里留空即可）-----------
GAME_NAME=
OFFICIAL_GAME_URL=
# 可以直接贴完整视频链接（youtube.com/watch?v=xxx 等），会自动识别成纯 ID。
YOUTUBE_VIDEO_ID=
DISCORD_URL=
YOUTUBE_CHANNEL_URL=
FANDOM_URL=
# 声明预期语言范围，逗号分隔（如 en,es,fr）——可选，纯粹用于 check:intake 核对
# intake/articles/ 下实际交付的语言目录是否跟这里声明的一致，不影响任何脚本的实际行为
# （实际处理哪些语言永远由 intake/articles/<locale>/ 目录本身决定）。
LANGUAGES=

# --- 覆盖素材路径（通常用 intake/hero/、intake/favicon/ 就够，这里留空即可）--------
HERO_IMAGE_SOURCE=
# 只有一张源图、需要让脚本生成整套 favicon 时才用这个；已经有生成器出好的一整套，
# 用下面的 FAVICON_SET_DIR 代替。
LOGO_SOURCE=
FAVICON_SET_DIR=

# --- 覆盖内容目录（几乎不需要改）-------------------------------------------------
ARTICLES_DIR=
HOMEPAGE_INFO_DIR=
