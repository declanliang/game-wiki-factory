# Copy to .env.local for local development, or set these as build-time
# secrets in your CI/deploy pipeline (see .github/workflows/deploy.yml).
# All are optional — every feature they gate degrades gracefully to "off"
# when the var is unset.

# --- Site identity -----------------------------------------------------
# Canonical domain used by sitemap.ts, robots.ts, og:url, and JSON-LD.
# A bare domain is normalized to HTTPS; a trailing slash/path is reduced to its origin.
# Complete https:// URLs remain the recommended Vercel value. This is public, not a secret.
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# --- Analytics (src/components/analytics.tsx) ---------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Microsoft Clarity project ID
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=
# Google AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX
# (loads the AdSense script; the actual ad units come from the NEXT_PUBLIC_AD_* vars below)
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=

# --- Ad slots (src/components/ad-slot.tsx) ------------------------------
# Each holds the raw embed snippet copy-pasted from your ad network
# (AdSense <ins> tag, PropellerAds/Adsterra <script> snippet, etc).
# Leave empty and the corresponding <AdSlot> renders nothing.
NEXT_PUBLIC_AD_SOCIAL_BAR=
NEXT_PUBLIC_AD_NATIVE_BANNER=
NEXT_PUBLIC_AD_BANNER_728X90=
NEXT_PUBLIC_AD_BANNER_300X250=
NEXT_PUBLIC_AD_BANNER_468X60=
NEXT_PUBLIC_AD_SIDEBAR_160X600=
NEXT_PUBLIC_AD_SIDEBAR_160X300=
NEXT_PUBLIC_AD_MOBILE_320X50=
