# Copy to .env.local for local development, or set these as build-time
# secrets in your CI/deploy pipeline (see .github/workflows/deploy.yml).
# All are optional — every feature they gate degrades gracefully to "off"
# when the var is unset.

# --- Site identity -----------------------------------------------------
# Canonical domain used by sitemap.ts, robots.ts, og:url, and JSON-LD.
# A bare domain is normalized to HTTPS; a trailing slash/path is reduced to its origin.
# Set the complete public HTTPS origin in Cloudflare Pages Production. This is public, not a secret.
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# --- Analytics (src/components/analytics.tsx) ---------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Microsoft Clarity project ID
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=
# Google AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX
# Loads the AdSense script; separate ad-unit markup is site-specific.
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=

# --- Optional runtime ad slots -----------------------------------------
# UTF-8 snippets encoded as standard Base64. Factory provisions the shared
# profile into Cloudflare Pages Preview and Production. Empty/invalid values
# render no iframe, placeholder, or spacing.
AD_NATIVE_BANNER_B64=
AD_NATIVE_BANNER_MOBILE_B64=
AD_BANNER_728X90_B64=
AD_BANNER_300X250_B64=
AD_BANNER_468X60_B64=
AD_SIDEBAR_160X600_B64=
AD_SIDEBAR_160X300_B64=
AD_MOBILE_320X50_B64=
