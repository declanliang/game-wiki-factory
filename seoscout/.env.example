# Secrets only. Everything else (batch sizes, workers, model name, timeouts,
# blocked domains, ...) lives in config.json instead — that file has no
# secrets in it, so it's tracked in git and can be committed/shared directly.

# === Required ===
SERPER_API_KEY=your_serper_api_key_here

# === Recommended ===
JINA_API_KEY=your_jina_api_key_here

# === DataForSEO (YouTube search + subtitles) — required for the YouTube step ===
# https://app.dataforseo.com/api-dashboard — Basic Auth login/password (not API key).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# === LLM API (generate + translate) — required ===
# Any OpenAI-compatible endpoint works; set the base URL/model in config.json.
# Multiple keys are round-robined across requests to spread rate limits/
# transient errors. Add LLM_API_KEY_2, _3, ... to add more.
LLM_API_KEY_1=your_llm_api_key_here
