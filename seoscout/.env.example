# === Required ===
SERPER_API_KEY=your_serper_api_key_here

# === Recommended ===
JINA_API_KEY=your_jina_api_key_here

# === Output ===
# Root directory for all project data (default: ./projects)
OUTPUT_DIR=./projects

# === DataForSEO (YouTube search + subtitles) ===
# Required for `seoscout search`/`collect`'s YouTube step.
# https://app.dataforseo.com/api-dashboard — Basic Auth login/password (not API key).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com
YOUTUBE_LOCATION_CODE=2840
YOUTUBE_LANGUAGE_CODE=en
YOUTUBE_DEVICE=desktop
YOUTUBE_OS=windows
YOUTUBE_BLOCK_DEPTH=10

# === LLM API (generate + translate) ===
# Required for `seoscout generate` and `seoscout translate`.
# Any OpenAI-compatible API endpoint works.
# Multiple keys are round-robined across requests to spread rate limits/
# transient errors. Add LLM_API_KEY_4, _5, ... to add more.
LLM_API_KEY_1=your_llm_api_key_here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=10000
LLM_FREQUENCY_PENALTY=0.3
LLM_PRESENCE_PENALTY=0.3
LLM_TIMEOUT=300
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_DELAY=5

# === Generate concurrency ===
# Number of articles to generate in parallel per batch
GENERATE_BATCH_SIZE=10
# Max concurrent API requests for generation
GENERATE_CONCURRENT_LIMIT=10

# === Translate concurrency ===
# Number of translations per batch
TRANSLATE_BATCH_SIZE=10
# Seconds to wait between batches
TRANSLATE_BATCH_DELAY=1

# === YouTube Tuning ===
# Skip videos longer than this (seconds)
YOUTUBE_MAX_DURATION=3600
# How many transcripts to extract per keyword
YOUTUBE_EXTRACT_TOP_K=1
# Parallel search workers (DataForSEO account concurrency limit applies)
YOUTUBE_SEARCH_WORKERS=3
# Parallel transcript extraction workers
YOUTUBE_TRANSCRIPT_WORKERS=5

# === Web Tuning ===
# Google results per keyword
WEB_SEARCH_TOP_N=10
# How many pages to extract per keyword
WEB_EXTRACT_TOP_K=1
# Serper API concurrency
WEB_SEARCH_CONCURRENCY=5
# Jina Reader rate limit (requests per minute)
JINA_RPM=200
# Jina Reader concurrency
JINA_CONCURRENCY=20
# Web extraction retries
WEB_EXTRACT_RETRIES=3

# === General ===
SEARCH_MAX_RETRIES=3
SEARCH_RETRY_DELAY=2
# Domains to exclude from web search results
BLOCKED_DOMAINS=youtube.com,youtu.be,reddit.com,discord.com
