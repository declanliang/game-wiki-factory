{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamewiki.local/schemas/adsterra-job.schema.json",
  "title": "Adsterra deployment job",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain_id", "domain_name", "placements"],
  "properties": {
    "schemaVersion": { "type": "integer" },
    "taskType": { "const": "ads" },
    "game": { "type": "string" },
    "domain_id": { "type": "string", "pattern": "^[0-9]+$" },
    "domain_name": { "type": "string", "minLength": 3 },
    "placements": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["placement_id", "title", "alias", "code"],
        "properties": {
          "placement_id": { "type": "string", "pattern": "^[0-9]+$" },
          "title": {
            "enum": [
              "Native Banner", "Banner 468x60", "Banner 300x250",
              "Banner 160x300", "Banner 160x600", "Banner 320x50", "Banner 728x90"
            ]
          },
          "alias": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
