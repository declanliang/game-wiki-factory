{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Wiki Agent2 Recovery Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "filesChanged", "verification"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["repaired", "retry_without_changes", "escalate", "no_action"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "filesChanged": {
      "type": "array",
      "items": {"type": "string", "maxLength": 300},
      "maxItems": 50
    },
    "verification": {
      "type": "array",
      "items": {"type": "string", "maxLength": 500},
      "maxItems": 30
    },
    "escalationReason": {
      "type": "string",
      "maxLength": 1200
    },
    "retrySafety": {
      "type": "string",
      "maxLength": 1200
    }
  }
}
