{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamewiki.local/schemas/background-site-job.schema.json",
  "title": "Game Wiki site job",
  "type": "object",
  "additionalProperties": false,
  "required": ["game"],
  "properties": {
    "schemaVersion": { "type": "integer" },
    "taskType": { "const": "site" },
    "operation": { "enum": ["auto", "new"] },
    "game": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["auto", "roblox", "steam"] },
    "officialUrl": { "type": "string", "format": "uri" },
    "siteUrl": { "type": "string", "minLength": 1 },
    "publish": { "type": "boolean" },
    "manualKeywords": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basicInfo": { "type": "boolean" },
        "keywords": { "type": "boolean" },
        "articles": { "type": "boolean" }
      }
    }
  }
}
