{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.auto-basic-info/schemas/game-homepage-package.schema.json",
  "title": "Roblox game homepage research package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "input", "facts", "evidence", "homepage", "modules", "validation"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameName", "platform"],
      "properties": {
        "gameName": { "type": "string", "minLength": 1 },
        "platform": { "const": "roblox" }
      }
    },
    "facts": { "$ref": "#/$defs/facts" },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "homepage": { "$ref": "#/$defs/homepage" },
    "modules": { "type": "array", "minItems": 4, "maxItems": 8, "items": { "$ref": "#/$defs/module" } },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sourceRef": { "type": "string", "pattern": "^src_[a-z0-9_]+$" },
    "factValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "sourceRefs"],
      "properties": {
        "value": {},
        "status": { "enum": ["verified", "supported", "inferred", "missing", "conflict"] },
        "sourceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sourceRef" } },
        "collectedAt": { "type": ["string", "null"], "format": "date-time" },
        "note": { "type": ["string", "null"] }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "roblox", "officialLinks", "media", "codes", "languages"],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonicalName", "robloxUrl", "placeId", "universeId", "creator"],
          "properties": {
            "canonicalName": { "$ref": "#/$defs/factValue" },
            "robloxUrl": { "$ref": "#/$defs/factValue" },
            "placeId": { "$ref": "#/$defs/factValue" },
            "universeId": { "$ref": "#/$defs/factValue" },
            "creator": { "$ref": "#/$defs/factValue" }
          }
        },
        "roblox": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/factValue" },
          "required": ["description", "playing", "visits", "favorites", "maxPlayers", "created", "updated"]
        },
        "officialLinks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "website": { "$ref": "#/$defs/factValue" },
            "discord": { "$ref": "#/$defs/factValue" },
            "youtube": { "$ref": "#/$defs/factValue" },
            "x": { "$ref": "#/$defs/factValue" },
            "tiktok": { "$ref": "#/$defs/factValue" },
            "group": { "$ref": "#/$defs/factValue" }
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trailer", "heroImages"],
          "properties": {
            "trailer": { "$ref": "#/$defs/factValue" },
            "heroImages": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/factValue" } }
          }
        },
        "codes": { "type": "array", "items": { "$ref": "#/$defs/factValue" } },
        "languages": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/factValue" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "sourceClass", "publisher", "supports", "retrievedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/sourceRef" },
        "url": { "$ref": "#/$defs/url" },
        "sourceClass": { "enum": ["A_ROBLOX", "A_CREATOR", "B_PLATFORM", "C_REPUTABLE_THIRD_PARTY", "D_COMMUNITY", "E_SEARCH_SNIPPET"] },
        "publisher": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "supports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "excerpt": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "homepage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteTitle", "metaTitle", "metaDescription", "hero", "startCards", "theme", "languages", "sidebarCodes", "faviconPrompt"],
      "properties": {
        "siteTitle": { "type": "string", "minLength": 1 },
        "metaTitle": { "type": "string", "minLength": 30, "maxLength": 60 },
        "metaDescription": { "type": "string", "minLength": 120, "maxLength": 160 },
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eyebrow", "title", "description", "stats", "imageUrls", "primaryCta"],
          "properties": {
            "eyebrow": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "stats": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "object", "required": ["label", "value", "factPath"], "properties": { "label": { "type": "string" }, "value": {}, "factPath": { "type": "string" } }, "additionalProperties": false } },
            "imageUrls": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/url" } },
            "primaryCta": { "$ref": "#/$defs/url" }
          }
        },
        "startCards": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["title", "description", "target"], "properties": { "title": { "type": "string" }, "description": { "type": "string" }, "target": { "type": "string" } } } },
        "theme": { "type": "object", "additionalProperties": false, "required": ["primaryHsl", "accentHsl", "backgroundHsl", "reason"], "properties": { "primaryHsl": { "type": "string", "pattern": "^\\d{1,3} \\d{1,3}% \\d{1,3}%$" }, "accentHsl": { "type": "string", "pattern": "^\\d{1,3} \\d{1,3}% \\d{1,3}%$" }, "backgroundHsl": { "type": "string", "pattern": "^\\d{1,3} \\d{1,3}% \\d{1,3}%$" }, "reason": { "type": "string" } } },
        "languages": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["locale", "label", "reason", "factPath"], "properties": { "locale": { "type": "string" }, "label": { "type": "string" }, "reason": { "type": "string" }, "factPath": { "type": "string" } } } },
        "sidebarCodes": { "type": "array", "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["code", "status", "factPath"], "properties": { "code": { "type": "string" }, "status": { "enum": ["active", "reported", "unknown"] }, "factPath": { "type": "string" } } } },
        "faviconPrompt": { "type": "string", "minLength": 20 }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "summary", "confidence", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "type": { "enum": ["codes", "guide", "tier-list", "faq"] },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "confidence": { "enum": ["verified", "supported", "editorial-draft"] },
        "sourceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors", "warnings", "metrics"],
      "properties": {
        "status": { "enum": ["pass", "warning", "fail"] },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "metrics": { "type": "object", "additionalProperties": false, "required": ["requiredFieldsComplete", "factsWithSources", "officialSourceRatio"], "properties": { "requiredFieldsComplete": { "type": "number", "minimum": 0, "maximum": 1 }, "factsWithSources": { "type": "number", "minimum": 0, "maximum": 1 }, "officialSourceRatio": { "type": "number", "minimum": 0, "maximum": 1 } } }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "field", "message"],
      "properties": { "code": { "type": "string" }, "field": { "type": "string" }, "message": { "type": "string" } }
    }
  }
}
