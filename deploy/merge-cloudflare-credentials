#!/usr/bin/env bash
set -euo pipefail

target="${1:-/srv/game-wiki-factory/secrets/factory.env}"
if [[ ! -f "$target" ]]; then
  echo "factory environment file does not exist: $target" >&2
  exit 1
fi

IFS= read -r account_id
IFS= read -r api_token
account_id="${account_id%$'\r'}"
api_token="${api_token%$'\r'}"
if [[ -z "$account_id" || -z "$api_token" ]]; then
  echo "expected non-empty Cloudflare account ID and API token on stdin" >&2
  exit 1
fi

umask 077
temporary="$(mktemp "${target}.XXXXXX")"
trap 'rm -f "$temporary"' EXIT
awk -F= '
  $1 != "CLOUDFLARE_ACCOUNT_ID" &&
  $1 != "CF_ACCOUNT_ID" &&
  $1 != "cf_accountid" &&
  $1 != "CLOUDFLARE_API_TOKEN" &&
  $1 != "CF_PAGES_API_TOKEN" &&
  $1 != "cf_pages_api_key" { print }
' "$target" > "$temporary"
printf '\nCLOUDFLARE_ACCOUNT_ID=%s\nCLOUDFLARE_API_TOKEN=%s\n' \
  "$account_id" "$api_token" >> "$temporary"
chown --reference="$target" "$temporary"
chmod 600 "$temporary"
mv -f "$temporary" "$target"
trap - EXIT

echo "Cloudflare credentials updated; values were not printed."
